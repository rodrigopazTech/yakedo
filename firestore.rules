rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function sesion() {
      return request.auth != null;
    }

    function dueno(uid) {
      return sesion() && request.auth.uid == uid;
    }

    function sinCobro(data) {
      return !('cobroActivoId' in data) || data.cobroActivoId == null;
    }

    function cobroIgual() {
      return (sinCobro(resource.data) ? null : resource.data.cobroActivoId)
        == (sinCobro(request.resource.data) ? null : request.resource.data.cobroActivoId);
    }

    function cobroSigueActivo(uid, pedidoId) {
      return !sinCobro(resource.data) && (
        !exists(/databases/$(database)/documents/negocios/$(uid)/pedidos/$(pedidoId)/cobros/$(resource.data.cobroActivoId))
        || get(/databases/$(database)/documents/negocios/$(uid)/pedidos/$(pedidoId)/cobros/$(resource.data.cobroActivoId)).data.venceEn > request.time
      );
    }

    match /config/{documento} {
      allow read: if sesion();
      allow write: if false;
    }

    match /clabes/{clabe} {
      allow read, write: if false;
    }

    match /cuentasPrivadas/{uid} {
      allow read, write: if false;
    }

    match /cuentasPey/{id} {
      allow read, write: if false;
    }

    match /webhooks/{id} {
      allow read, write: if false;
    }

    match /pagosSinAsignar/{id} {
      allow read, write: if false;
    }

    match /cobrosQr/{id} {
      allow read, write: if false;
    }

    match /eventosCobro/{id} {
      allow read, write: if false;
    }

    match /negocios/{uid} {
      allow read: if dueno(uid);
      allow create, delete: if false;
      allow update: if dueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 40;

      match /cuenta/{documento} {
        allow read: if dueno(uid);
        allow write: if false;
      }

      function textoCorto(valor) {
        return valor is string && valor.size() > 0 && valor.size() <= 40;
      }

      function productoValido() {
        return textoCorto(request.resource.data.nombre)
          && request.resource.data.precioCentavos is int
          && request.resource.data.precioCentavos > 0
          && request.resource.data.precioCentavos <= 100000000
          && (request.resource.data.categoriaId == null || request.resource.data.categoriaId is string)
          && (request.resource.data.agotadoEl == null || request.resource.data.agotadoEl is string)
          && request.resource.data.tieneFoto is bool
          && request.resource.data.keys().hasOnly(['nombre', 'precioCentavos', 'categoriaId', 'agotadoEl', 'tieneFoto']);
      }

      match /categorias/{id} {
        allow read: if dueno(uid);
        allow delete: if dueno(uid);
        allow create, update: if dueno(uid)
          && textoCorto(request.resource.data.nombre)
          && request.resource.data.keys().hasOnly(['nombre']);
      }

      match /productos/{id} {
        allow read: if dueno(uid);
        allow delete: if dueno(uid);
        allow create, update: if dueno(uid) && productoValido();
      }

      match /contadores/{id} {
        allow read: if dueno(uid);
        allow create: if dueno(uid)
          && id == 'pedidos'
          && request.resource.data.valor == 1
          && request.resource.data.keys().hasOnly(['valor']);
        allow update: if dueno(uid)
          && id == 'pedidos'
          && request.resource.data.valor is int
          && request.resource.data.valor == resource.data.valor + 1
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['valor']);
      }

      match /pedidos/{pedidoId} {
        allow read: if dueno(uid);
        allow delete: if false;
        allow create: if dueno(uid)
          && request.resource.data.estado == 'Pendiente'
          && sinCobro(request.resource.data)
          && (!('metodo' in request.resource.data) || request.resource.data.metodo == null);
        allow update: if dueno(uid)
          && cobroIgual()
          && (
            request.resource.data.estado != 'Pagado'
            || (
              request.resource.data.metodo == 'efectivo'
              && resource.data.estado != 'Pagado'
              && resource.data.estado != 'Cancelado'
            )
          )
          && (
            request.resource.data.estado != 'Cancelado'
            || !cobroSigueActivo(uid, pedidoId)
          );

        match /cobros/{cobroId} {
          allow read: if dueno(uid);
          allow write: if false;

          match /pagos/{pagoId} {
            allow read: if dueno(uid);
            allow write: if false;
          }
        }
      }
    }
  }
}
