# Configuración web de Firebase. Copia este archivo a .env.local y llena
# los valores en tu máquina. .env.local no se sube. Aquí los valores van vacíos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloud Functions. Estos nombres se cargan desde Firebase Secret Manager.
# No escribas la llave de Pey ni el secreto del webhook en este archivo.
# PEY_API_KEY
# PEY_WEBHOOK_SECRET
